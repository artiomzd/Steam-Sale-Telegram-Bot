# ============================================================
# .env — Секреты и настройки бота
# ВАЖНО: этот файл НЕ коммитится в Git (добавлен в .gitignore)
# Скопируй этот файл: cp .env.example .env
# И заполни своими значениями
# ============================================================

# Токен бота от @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Твой Telegram ID (узнать у @userinfobot)
ADMIN_ID=123456789

# Интервал проверки скидок в часах
CHECK_INTERVAL_HOURS=12

# Регион Steam для запросов цен
# kz=Казахстан, us=США, de=Германия, tr=Турция
GLOBAL_STEAM_REGION=kz

# Белый список: true = только ты, false = все пользователи
# Я забыл сюда добавить возможность добавить людей в белый список, так что сделаю это позже.
WHITELIST_ENABLED=false

# Показывать баннеры (обложки игр) в уведомлениях
ENABLE_BANNERS=true

# Порог скидки по умолчанию (%)
DEFAULT_THRESHOLD=75
